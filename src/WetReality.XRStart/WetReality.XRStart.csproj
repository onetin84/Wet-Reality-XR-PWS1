<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Steam-Standardort als Vorgabe. Liegt das Spiel woanders, gehoert der
         Pfad in Directory.Build.props im Wurzelverzeichnis (nicht versioniert,
         Vorlage daneben) oder an die Befehlszeile: -p:GamePath="D:\..." -->
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\PowerWash Simulator</GamePath>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=./</PathMap>
    <!-- Zwei Stellen tragen die Nummer: hier und MelonInfo in XRStart.cs. -->
    <Version>0.9.1</Version>
    <AssemblyVersion>0.9.1</AssemblyVersion>
    <FileVersion>0.9.1</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader" HintPath="$(GamePath)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(GamePath)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(GamePath)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GamePath)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll" Private="false" />
    <!-- Unity 2020.3: XRSettings liegt in VRModule, XRDisplaySubsystem in
         XRModule, die Subsystem-Basis in SubsystemsModule. -->
    <Reference Include="UnityEngine.VRModule" HintPath="$(GamePath)\MelonLoader\Il2CppAssemblies\UnityEngine.VRModule.dll" Private="false" />
    <Reference Include="UnityEngine.XRModule" HintPath="$(GamePath)\MelonLoader\Il2CppAssemblies\UnityEngine.XRModule.dll" Private="false" />
    <Reference Include="UnityEngine.SubsystemsModule" HintPath="$(GamePath)\MelonLoader\Il2CppAssemblies\UnityEngine.SubsystemsModule.dll" Private="false" />
    <!-- Die managed XR-Schicht ist in PWS1 einkompiliert (Handbuch 1.2) -
         anders als bei PWS2 wird sie hier nur aufgerufen, nicht nachgebaut. -->
    <Reference Include="Unity.XR.Management" HintPath="$(GamePath)\MelonLoader\Il2CppAssemblies\Unity.XR.Management.dll" Private="false" />
    <!-- Nur fuer den Kameradump: renderType (Base/Overlay) steht an
         UniversalAdditionalCameraData, nicht an der Kamera. -->
    <Reference Include="Unity.RenderPipelines.Universal.Runtime" HintPath="$(GamePath)\MelonLoader\Il2CppAssemblies\Unity.RenderPipelines.Universal.Runtime.dll" Private="false" />
    <!-- Posequellen: XRHMD/XRController legt das Input System an, sobald die
         OpenXR-Schicht ihre Action Sets angehaengt hat (Handbuch 2). -->
    <Reference Include="Unity.InputSystem" HintPath="$(GamePath)\MelonLoader\Il2CppAssemblies\Unity.InputSystem.dll" Private="false" />
    <Reference Include="Unity.XR.OpenXR" HintPath="$(GamePath)\MelonLoader\Il2CppAssemblies\Unity.XR.OpenXR.dll" Private="false" />
    <!-- 0.5.0: Zaehler auf PlayerCameraController (Handbuch 2.5). -->
    <Reference Include="Il2CppPWS" HintPath="$(GamePath)\MelonLoader\Il2CppAssemblies\Il2CppPWS.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GamePath)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <!-- 0.7.0: EquipmentManager erbt von MLAPI.NetworkBehaviour. -->
    <Reference Include="Unity.Multiplayer.MLAPI.Runtime" HintPath="$(GamePath)\MelonLoader\Il2CppAssemblies\Unity.Multiplayer.MLAPI.Runtime.dll" Private="false" />
    <Reference Include="Il2CppInterop.Common" HintPath="$(GamePath)\MelonLoader\net6\Il2CppInterop.Common.dll" Private="false" />
  </ItemGroup>
</Project>
